{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": [
    "contracts/**/*",
    "scripts/**/*",
    "test/**/*",
    "src/**/*",
    "hardhat.config.ts"
  ],
  "exclude": ["node_modules"]
}
